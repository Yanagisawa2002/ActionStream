<?xml version="1.0"?>
<package format="3">
  <name>action_stream_benchmark</name>
  <version>0.1.0</version>
  <description>Paired fault injection, deterministic test plant, replay audit, and analysis for ActionStream M7.</description>
  <maintainer email="cgliu@localhost">ActionStream maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>action_stream_msgs</exec_depend>
  <exec_depend>action_stream_policy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>rosidl-runtime-py</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
