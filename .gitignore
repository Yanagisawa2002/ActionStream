__pycache__/
*.py[cod]
.pytest_cache/
/.tmp_pytest_*/
.ruff_cache/
.venv/
*.egg-info/
.external/
/logs/
/ros2_ws/build/
/ros2_ws/install/
/ros2_ws/log/

# Runtime outputs are ignored by default. The release branch force-tracks only
# the curated paths accepted by release/public_release_manifest.json.
/outputs/**

# Local transfer bundles and generated release evidence.
/*.bundle
/*.tgz
/artifacts/**

# Formal GPU benchmark transfer bundles and raw replay/video payloads stay local.
# Curated reports, CSVs, plots, and contact sheets are tracked explicitly.
/reports/actionstream_backend_gpu_v1/*.tgz
/reports/actionstream_backend_gpu_v1/raw/
/reports/actionstream_backend_gpu_v1/actionstream_backend_gpu_v1/
/reports/actionstream_backend_gpu_v1/selected_evidence/
/reports/actionstream_backend_gpu_v1/*.log
