  "deadline_semantics": {
    "startup_request": "First inference request on every newly established TCP connection; reset/control frames do not consume the startup ordinal.",
    "subsequent_requests": "All later inference requests on that connection use the steady budget, including after a server error response.",
    "periodic_pre_inference_disconnect": "Next inference after reconnect receives the 15 s startup budget; latency and failures remain reported.",
    "budget_scope": "Per admitted inference request: connect if needed, serialization, send, queue wait, worker service, injected delivery delay, receive and decode. Connect has an additional 3 s cap within this budget. CPU encode/decode are not preempted; expiry is checked before accepting results.",
    "outer_action_wait": "20 s from waiting for an action. Covers retries/backoff cumulatively and can cancel a later retry before its individual startup budget expires. Does not guarantee recovery or completion of every retry.",
    "legacy_inference_timeout_s": "5 s fallback for transports without explicit paired budgets; v2 TCP overrides it with the selected startup/steady budget.",
    "startup_budget_rationale": "15 s is an outcome-informed experimental safety budget selected after observing approximately 6.6-6.9 s connection-first inference latency. It is not a measured SLA.",
    "timeout_invalidation": "Close socket and invalidate client generation. Remote synchronous work may finish; running CUDA is not preempted.",
    "warmup_policy": "No inference warmup or discarded bootstrap request. Report first requests and reconnect latency. If the cold penalty persists, preserve it; if it disappears, report that later as an observation, not an assumption."
  },
  "server_execution": {
    "worker_instances_per_server": 1,
    "persistent_executor_threads_per_server": 1,
    "queue": "FIFO validated requests; one outstanding request per connection; policy inference and idle reset controls serialized on the same persistent thread.",
    "obsolete_requests": "Drop before compute when server shutdown, connection EOF/error or handler invalidation is observed. Detection races with compute admission; an already admitted call may finish.",
    "reset": "Preserve client generation invalidation. Active reset cancels that client request path immediately; idle reset submits worker reset to the executor. Does not globally reset other clients or preempt in-flight work.",
    "shutdown": "Stop admission, close sockets, stop handler producers, drain queued work as obsolete, wait for active worker call, join executor. No bounded guarantee if the worker never returns.",
    "cuda_synchronization": "No CUDA synchronization added to generic RPC transport. Existing X-VLA backend synchronization remains unchanged."
  },
  "response_telemetry": {
    "server_queue_wait_s": "Monotonic elapsed time from immediately before queue insertion to executor admission after obsolete check; includes queue scheduling, excludes request decode and injected pre-inference stall.",
    "server_compute_s": "Elapsed time immediately surrounding the actual inference callable, including its preprocessing/postprocessing; not pure GPU kernel time. No new CUDA synchronization.",
    "server_service_s": "Executor admission to response-ready payload: callable, validation, CPU materialization and error handling; excludes queue wait, injected delivery delay, JSON serialization and socket send.",
    "server_inference_s": "Legacy composite: queue wait plus worker/validation interval, excluding successful CPU materialization and delivery. v1 used lock wait instead of executor queue wait. Not renamed to pure compute.",
    "server_lock_wait_s": "Omitted: there is no policy inference lock in v2. Queue wait replaces policy-lock contention; do not fabricate a measured zero.",
    "connection_id": "Unique random ID per accepted TCP connection.",
    "connection_request_ordinal": "1-based validated inference request count per connection; control frames excluded; injected pre-inference disconnect requests included.",
    "global_request_ordinal": "1-based validated inference request count per fresh server; drives unchanged deterministic fault matching. request_ordinal remains its compatibility alias.",
